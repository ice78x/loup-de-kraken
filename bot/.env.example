# ============================================================
# Kraken Assistant — configuration
# Copie ce fichier en .env puis remplis. .env est dans .gitignore.
# ============================================================

# --- Clés API Kraken SPOT (optionnelles pour le mode analyse/paper) ---
# Permissions MINIMALES recommandées :
#   - Funds permissions : Query
#   - Orders and trades : Query open orders & trades, Query closed orders & trades
# NE COCHE PAS "Create & modify orders" tant que tu n'actives pas le live.
# NE COCHE JAMAIS "Withdraw funds".
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Clés API Kraken FUTURES (optionnelles) — clé "read-only" suffit ---
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=

# Pays utilisé pour filtrer les paires disponibles (ISO 3166-1 alpha-2)
COUNTRY_CODE=FR

# --- Capital & risque ---
# Capital de départ du compte PAPER (en EUR). En live, le capital est lu sur Kraken.
CAPITAL_EUR=90
RISK_NORMAL_PCT=1.0
RISK_EXCEPTIONAL_PCT=2.0
MAX_OPEN_RISK_PCT=2.0
MAX_DAILY_LOSS_PCT=3.0
MAX_LEVERAGE=10

# Frais par défaut (estimation, en % du notionnel, par côté) utilisés si Kraken
# ne renvoie pas tes frais réels (endpoint privé TradeVolume). À vérifier sur ton compte.
DEFAULT_SPOT_TAKER_FEE_PCT=0.40
DEFAULT_FUTURES_TAKER_FEE_PCT=0.05

# --- Scanner ---
# Paires analysées : uniquement contre USD par défaut. Pour ajouter l'euro : ["USD","EUR"]
QUOTE_CURRENCIES=["USD"]
SCAN_INTERVAL_MINUTES=60
WATCH_INTERVAL_MINUTES=10
SCHEDULER_ENABLED=true
UNIVERSE_MAX_CRYPTO=30
UNIVERSE_MAX_XSTOCKS=10
UNIVERSE_MAX_COMMODITIES=8
FUTURES_ENABLED=true
NEWS_ENABLED=true

# Clé optionnelle Finnhub (calendrier des résultats d'entreprises pour les xStocks)
FINNHUB_API_KEY=

# --- Historique & optimiseur ---
OPTIMIZER_ENABLED=true
OPTIMIZER_HOUR_LOCAL=3
OPTIMIZER_MAX_BARS=12000
OPTIMIZER_MIN_TRADES=15
USE_OPTIMIZED_PARAMS=true
DEFAULT_SPOT_MAKER_FEE_PCT=0.25
DEFAULT_FUTURES_MAKER_FEE_PCT=0.02

# --- PAPER ---
PAPER_AUTO_MANAGE=true

# --- LIVE : OFF PAR DÉFAUT ---
# Pour activer, il faut LES DEUX lignes suivantes + une confirmation par ordre.
LIVE_TRADING=false
LIVE_TRADING_ACK=
# Valeur exacte attendue pour LIVE_TRADING_ACK : J_ACCEPTE_LE_RISQUE_REEL

# User-Agent envoyé aux sources de news. La SEC exige un contact : mets ton e-mail.
USER_AGENT=kraken-assistant/0.1 (contact: ton-email@exemple.com)

# --- Serveur ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
